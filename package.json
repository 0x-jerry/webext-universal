{
  "name": "webext-universal",
  "description": "Mouse gestures for web browser.",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "pack:crx": "crx3 pack .output/chrome-mv3 -o webext-universal.crx -p ./key.pem",
    "build:prepare": "bun run ./scripts/prepare.ts",
    "postinstall": "wxt prepare",
    "release": "x-release --publish false"
  },
  "dependencies": {
    "@0x-jerry/utils": "^6.6.0",
    "@floating-ui/vue": "^2.0.1",
    "@vueuse/core": "^15.0.0",
    "tdesign-vue-next": "^1.20.9",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@0x-jerry/x-release": "^3.0.5",
    "@iconify-json/carbon": "^1.2.28",
    "@types/chrome": "^0.3.4",
    "@wxt-dev/module-vue": "^1.0.3",
    "@wxt-dev/unocss": "^1.0.1",
    "crx3": "^2.0.0",
    "less": "^4.9.1",
    "normalize.css": "^8.0.1",
    "typescript": "npm:typescript-native-bridge@latest",
    "unocss": "^66.10.5",
    "wxt": "^0.21.4"
  }
}